<div class="category">
    <p><%= category.name %></p>
    <form action="/categories/<%= category.id %>/delete" method="POST">
        <input type="password" name="password" placeholder="Enter password to confirm" required>
        <button type="submit">Delete Category</button>
    </form>

    <ul>
        <% products.forEach(product => { %>
            <li><%= product.name %></li>
        <% }) %>
    </ul>
</div>