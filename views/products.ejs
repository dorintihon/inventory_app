<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('navbar') %>

    <h1>All Products in Inventory</h1>
    <a href="/products/new_product">Add New Product</a>
    <ul>
        <% products.forEach(product => { %>
            <li><a href="/products/<%= product.id %>"><%= product.name %> (<%= product.category_name %>)</a></li>
        <% }); %>
    </ul>
</body>
</html>