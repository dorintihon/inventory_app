<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('navbar') %>

    <h1>All Categories in Inventory</h1>
    <a href="/categories/new_category">Add New Category</a>
    <ul>
        <% categories.forEach(category => { %>
            <li><a href="/categories/<%= category.id %>"><%= category.name %></a></li>
        <% }); %>
    </ul>
</body>
</html>